---
import Base from './Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Showreel from '../components/Showreel.astro';
import SectionFooter from '../components/SectionFooter.astro';

interface Props {
  view: 'xr' | 'motion';
  title: string;
  description: string;
  heading: string;
  creds: string;
  intro: string;
  filters: string[];
  projects: any[];
  reel?: string | { video?: string; url?: string; poster?: string } | null;   // a YouTube/Vimeo URL or a local file
  reelLabel: string;
  cvHref?: string | null;
  cvLabel: string;
  showStudio?: boolean;
}
const { view, title, description, heading, creds, intro, filters, projects, reel, reelLabel, cvHref, cvLabel, showStudio } = Astro.props;
const r = typeof reel === 'string' ? { url: reel } : (reel ?? {});
---
<Base title={title} description={description} view={view}>
  <section class={`section section--${view}`} aria-labelledby="sec-h">
    <a class="back" href="/">← Back to the fork</a>
    <div class="sec-head">
      <div>
        <h1 id="sec-h" set:html={heading} />
        <div class="creds">{creds}</div>
        <p>{intro}</p>
      </div>
      <div class="filters" role="group" aria-label="Filter work">
        <button class="chip" type="button" aria-pressed="true" data-tag="">All</button>
        {filters.map(f => <button class="chip" type="button" aria-pressed="false" data-tag={f}>{f}</button>)}
      </div>
    </div>
    <slot name="above-reel" />
    <Showreel label={reelLabel} url={r.url} video={r.video} poster={r.poster} />
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} side={view} index={i} />)}
    </div>
    <SectionFooter cvHref={cvHref} cvLabel={cvLabel} showStudio={showStudio} />
  </section>
</Base>

<script>
  // Filter chips: show cards whose tags include the chosen one. No animation; it answers a click, nothing more.
  const group = document.querySelector('.filters');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.card'));
  group?.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip'); if (!b) return;
    group.querySelectorAll('.chip').forEach(c => c.setAttribute('aria-pressed', String(c === b)));
    const tag = b.dataset.tag ?? '';
    cards.forEach(c => { c.hidden = !!tag && !(c.dataset.tags ?? '').split('|').includes(tag); });
  });
</script>
