---
import CaseStudy from '../../layouts/CaseStudy.astro';
import projects from '../../data/projects-xr.json';
export function getStaticPaths() {
  return projects.filter(p => p.desc).map(p => ({ params: { slug: p.slug }, props: { p } }));
}
const { p } = Astro.props;
---
<CaseStudy view="xr" p={p} all={projects} />
