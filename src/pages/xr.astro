---
import Section from '../layouts/Section.astro';
import site from '../data/site.json';
import projects from '../data/projects-xr.json';
---
<Section
  view="xr"
  title="XR · Tolu Aina"
  description="Mixed-reality tools for clinicians, AR games on iOS, playable Snap Lenses, multiplayer VR for Quest, and product design systems. Unity, C#, Meta XR SDK, ARKit, WebXR."
  heading="XR"
  creds="XRCC 2026 finalist · MSc Computer Science, Distinction · Founder, GaldAR Studio"
  intro="Shipped and in-progress work from GaldAR Studio and the MSc: mixed reality on Quest 3, AR on iOS and in Snapchat, WebXR in the browser. Open a project for the demo, the build and the thinking behind it."
  filters={['Mixed reality', 'Mobile AR', 'VR', 'WebXR', 'Snap AR']}
  projects={projects}
  reel={site.showreel.xr}
  reelLabel="Play XR showreel"
  cvHref={site.cv.xr}
  cvLabel="CV for XR and Unity roles"
  showStudio
>
  <p class="studio-line" slot="above-reel">Commercial spatial work runs through <a href={site.studio} target="_blank" rel="noopener">GaldAR Studio</a>. This page is the personal record of it.</p>
</Section>
