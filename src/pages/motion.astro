---
import Section from '../layouts/Section.astro';
import site from '../data/site.json';
import projects from '../data/projects-motion.json';
---
<Section
  view="motion"
  title="Motion · Tolulope Aina"
  description="Motion design: 500+ explainer and campaign videos, UI motion systems, and AI-assisted animation pipelines. After Effects, Illustrator, 2D and 3D."
  heading="Motion"
  creds="6+ years · uLesson · Miva Open University · AdLiven · School of Motion · Motion Design School"
  intro="Selected motion work. Each tile loops silently; open a project for the full piece, the brief, and how it was built."
  filters={['Explainers', 'Campaigns', 'UI motion', '3D', 'Pipelines']}
  projects={projects}
  reel={site.showreel.motion}
  reelLabel="Play motion showreel"
  cvHref={site.cv.motion}
  cvLabel="CV for motion roles"
/>
