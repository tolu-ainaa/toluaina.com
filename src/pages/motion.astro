---
import Section from '../layouts/Section.astro';
import site from '../data/site.json';
import projects from '../data/projects-motion.json';
---
<Section
  view="motion"
  title="Motion · Tolu Aina"
  description="Motion design: 500+ explainer and campaign videos, UI motion systems, and AI-assisted animation pipelines. After Effects, Illustrator, 2D and 3D."
  heading="Motion"
  creds="6+ years · uLesson · Miva Open University · AdLiven · School of Motion · Motion Design School"
  intro="Six years of motion work: explainers made at scale for edtech, campaign cuts for brands, and the personal experiments where the ideas get tested first. Hover a tile to see it move; open one for the full film, the brief and how it was made."
  filters={['Explainers', 'Campaigns', 'Studio work', 'UI motion', '3D', 'Experiments']}
  projects={projects}
  reel={site.showreel.motion}
  reelLabel="Play motion showreel"
  cvHref={site.cv.motion}
  cvLabel="CV for motion roles"
/>
