---
// Showreel slot. Accepts a YouTube/Vimeo URL (iframe loads only on play) or a local video file.
interface Props { label: string; url?: string | null; video?: string | null; poster?: string | null; portrait?: boolean }
const { label, url, video, poster, portrait = false } = Astro.props;

function embedUrl(u: string): string | null {
  const yt = u.match(/(?:youtu\.be\/|v=|\/embed\/)([\w-]{11})/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}?autoplay=1&rel=0&modestbranding=1`;
  const vm = u.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vm) return `https://player.vimeo.com/video/${vm[1]}?autoplay=1&title=0&byline=0&portrait=0`;
  const gd = u.match(/drive\.google\.com\/(?:file\/d\/|open\?id=)([\w-]+)/);   // public "anyone with the link" files only
  if (gd) return `https://drive.google.com/file/d/${gd[1]}/preview`;
  return null;
}
const embed = url ? embedUrl(url) : null;
const ready = !!(embed || video);
---
<div class:list={["reel", { "reel--portrait": portrait }]} data-embed={embed ?? undefined} data-video={video ?? undefined}>
  {poster && <img src={poster} alt="" loading="lazy" decoding="async" />}
  <button class="play" type="button" disabled={!ready}>▶ {label}</button>
  {!ready && <span class="cap">showreel slot · add a link or file in site.json</span>}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.reel[data-embed], .reel[data-video]').forEach(reel => {
    reel.querySelector('.play')?.addEventListener('click', () => {
      if (reel.dataset.embed) {
        const f = document.createElement('iframe');
        f.src = reel.dataset.embed; f.allow = 'autoplay; fullscreen; picture-in-picture';
        f.setAttribute('allowfullscreen', ''); f.title = 'Showreel';
        reel.replaceChildren(f);
      } else if (reel.dataset.video) {
        const v = document.createElement('video');
        v.src = reel.dataset.video; v.controls = true; v.playsInline = true;
        v.poster = reel.querySelector('img')?.src ?? '';
        reel.replaceChildren(v);
        v.play().catch(() => {});
      }
    });
  });
</script>
