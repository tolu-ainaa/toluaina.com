---
import site from '../data/site.json';

// Background loops. Drop files into public/media and point site.json at them; until then a canvas stands in.
const loops = (site as any).loops ?? {};
const xrLoop = loops.xr ?? null;
const motionLoop = loops.motion ?? null;
---
<div class="fork-wrap">
  <main class="fork" id="fork">
    <a class="panel panel--xr" href="/xr" data-side="xr" aria-label="Enter XR and product work">
      {xrLoop?.src
        ? <video muted playsinline loop autoplay preload="none" poster={xrLoop.poster} aria-hidden="true"><source src={xrLoop.src} type="video/mp4" /></video>
        : <canvas id="cv-xr" aria-hidden="true"></canvas>}
      <div class="meta">Unity · C# · Meta XR SDK · ARKit · WebXR<br />Quest 3 · passthrough · hand tracking · spatial UI</div>
      <div class="eyebrow">/xr</div>
      <h2>XR &amp; Product</h2>
      <p>Mixed-reality tools for clinicians, AR games on iOS, playable Snap Lenses, multiplayer VR for Quest, and the product design systems around them.</p>
      <span class="enter"><i></i> Enter builds &amp; systems</span>
    </a>
    <a class="panel panel--motion" href="/motion" data-side="motion" aria-label="Enter motion work">
      {motionLoop?.src
        ? <video muted playsinline loop autoplay preload="none" poster={motionLoop.poster} aria-hidden="true"><source src={motionLoop.src} type="video/mp4" /></video>
        : <canvas id="cv-motion" aria-hidden="true"></canvas>}
      <div class="meta">After Effects · Illustrator · Figma<br />2D / 3D · 24 fps · 500+ videos shipped</div>
      <div class="eyebrow">/motion</div>
      <h2>Motion</h2>
      <p>Explainers at scale, brand campaigns, UI motion and AI-assisted animation pipelines. Six years, 500+ videos, and an animation team of 20+ led.</p>
      <span class="enter"><i></i> Enter motion reel</span>
    </a>
  </main>
  <div class="seam-note">hover a side to widen it · click to enter</div>
</div>

<script>
  import { startForkCanvases } from '../scripts/fork-canvas';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mobile = () => matchMedia('(max-width: 860px)').matches;
  const fork = document.getElementById('fork')!;
  const panels = Array.from(fork.querySelectorAll<HTMLAnchorElement>('.panel'));
  const forkMs = () => parseFloat(getComputedStyle(document.body).getPropertyValue('--fork-ms')) || 520;

  startForkCanvases();

  // Reduced motion: no autoplaying video either.
  if (reduce) fork.querySelectorAll('video').forEach(v => { v.removeAttribute('autoplay'); v.pause(); });

  // Phones: tap a half, it grows to fill the screen, then the section page loads and rises in.
  panels.forEach(panel => {
    panel.addEventListener('click', (e) => {
      if (!mobile() || reduce || fork.classList.contains('is-expanding')) return;
      e.preventDefault();
      const side = panel.dataset.side!;
      fork.classList.add('is-expanding'); panel.classList.add('is-target');
      sessionStorage.setItem('ta-last-side', side);
      sessionStorage.setItem('ta-from-fork', '1');
      sessionStorage.setItem('ta-arrive', '1');
      let done = false;
      const go = () => { if (done) return; done = true; location.href = panel.href; };
      panel.addEventListener('transitionend', (ev) => { if (ev.propertyName === 'flex-grow') go(); }, { once: true });
      setTimeout(go, forkMs() + 150);
    });
  });

  // Coming back to the fork on a phone: start with the last-tapped half full-screen, then let it shrink to 50/50.
  function settleFromLastSide() {
    const side = sessionStorage.getItem('ta-last-side');
    sessionStorage.removeItem('ta-last-side');
    sessionStorage.removeItem('ta-from-fork');
    fork.classList.remove('is-expanding');
    panels.forEach(p => p.classList.remove('is-target', 'is-settling'));
    if (!side || !mobile() || reduce) return;
    const target = fork.querySelector(`[data-side="${side}"]`)!;
    const other = fork.querySelector(`.panel:not([data-side="${side}"])`)!;
    fork.classList.add('no-anim', 'is-expanding'); target.classList.add('is-target'); other.classList.add('is-settling');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      fork.classList.remove('no-anim', 'is-expanding'); target.classList.remove('is-target');
      setTimeout(() => other.classList.remove('is-settling'), forkMs() + 100);
    }));
  }
  settleFromLastSide();
  // Back-forward cache restores the page as we left it (expanded); run the settle again.
  addEventListener('pageshow', (e) => { if (e.persisted) settleFromLastSide(); });
</script>
