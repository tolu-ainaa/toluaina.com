---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import site from '../data/site.json';
interface Props { cvHref?: string | null; cvLabel?: string; showStudio?: boolean }
const { cvHref, cvLabel, showStudio = false } = Astro.props;
const cvReady = !!cvHref && existsSync(join(process.cwd(), 'public', cvHref));
---
<div class="sec-foot">
  {cvHref && (
    <div>
      <h4>{cvLabel}</h4>
      {cvReady
        ? <a class="btn" href={cvHref} download>Download CV <small>(PDF)</small></a>
        : <a class="btn" href={`mailto:${site.email}?subject=${encodeURIComponent("CV request: " + cvLabel)}`}>Request CV <small>(by email)</small></a>}
    </div>
  )}
  <div>
    <h4>Get in touch</h4>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
    <div class="links">
      <a href={site.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      {showStudio && <a href={site.studio} target="_blank" rel="noopener">galdar.studio</a>}
      <a href="/">Back to the fork</a>
    </div>
  </div>
</div>
